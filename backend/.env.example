# LLM provider used by the Interview Agent (question generation + evaluation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-6

# Database (SQLite by default; swap for a Postgres URL to migrate)
DATABASE_URL=sqlite:///./interview.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Speech services are handled client-side via the browser's Web Speech API
# (SpeechRecognition for STT, SpeechSynthesis for TTS) so no keys are
# required for voice by default. The speech_service/tts_service/stt_service
# modules are structured so a real provider (e.g. ElevenLabs, Deepgram,
# Azure Speech, Whisper) can be dropped in without changing route code.
